{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm db:generate"
  },
  "deploy": {
    "startCommand": "node scripts/check-production-env.mjs worker && pnpm worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
