# Local development only. scripts/setup.mjs generates unique local credentials.
POSTGRES_USER=dance
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=dance
DATABASE_URL=postgresql://dance:replace-with-local-password@127.0.0.1:54329/dance
REDIS_URL=redis://127.0.0.1:63799
MINIO_ROOT_USER=dance-local
MINIO_ROOT_PASSWORD=replace-with-local-storage-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=dance-media
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-setup
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Dance Community <hello@dance.local>

# Optional integrations. Uncomment and configure only the services you use.
# Google OAuth: register the callback /api/auth/callback/google on BETTER_AUTH_URL.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Admin runs separately and shares the database and auth secret.
# ADMIN_URL=http://localhost:3001
# WEB_URL=http://localhost:3000
# Media defaults to the local adapter when complete S3 credentials are absent.
# MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=C:/dev/dance_app/.data/media
# MEDIA_SIGNING_SECRET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=
# Use a persistent production volume or S3, never an ephemeral filesystem.
# Self-hosted geocoding and branded/hosted map tiles:
# GEOCODER_URL=
# PHOTON_URL=
# GEOCODER_USER_AGENT=bailamos/0.1 (https://your-domain.example)
# NEXT_PUBLIC_MAP_STYLE_URL=
# DEFAULT_CITY_SLUG=mexico-city
# Background worker (REDIS_URL is required):
# WORKER_QUEUE=dance-jobs
# WORKER_CONCURRENCY=2
# WORKER_JOBS=reminders.events,digest.weekly,media.sweep,ratelimit.cleanup,import.sources,import.news.prune
# CRON_SECRET=
# Web Push uses a generated VAPID key pair:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@your-domain.example
# Instagram degrades to a link card when provider access is unavailable:
# INSTAGRAM_OEMBED_TOKEN=
# Telegram webhook configuration:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
