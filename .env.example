# Local development only. scripts/setup.mjs generates unique local credentials.
POSTGRES_USER=dance
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=dance
DATABASE_URL=postgresql://dance:replace-with-local-password@127.0.0.1:54329/dance
REDIS_URL=redis://127.0.0.1:63799
MINIO_ROOT_USER=dance-local
MINIO_ROOT_PASSWORD=replace-with-local-storage-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=dance-media
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-setup
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Dance Community <hello@dance.local>
