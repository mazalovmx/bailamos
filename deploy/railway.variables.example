# Template only. Replace placeholders in Railway Variables; never commit real secrets.
# Shared by web + worker; DATABASE_URL and BETTER_AUTH_SECRET also go to admin.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
BETTER_AUTH_URL=https://bailamos.me
BETTER_AUTH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_48_BYTE_SECRET
RAILPACK_PRUNE_DEPS=false
RAILPACK_NODE_VERSION=22
NEXT_TELEMETRY_DISABLED=1
ADMIN_URL=https://admin.bailamos.me
WEB_URL=https://bailamos.me
PORT=3000
SMTP_HOST=REPLACE_WITH_MAIL_PROVIDER_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_MAIL_PROVIDER_USER
SMTP_PASSWORD=REPLACE_WITH_MAIL_PROVIDER_PASSWORD
SMTP_FROM=Bailamos <hello@bailamos.me>
MEDIA_STORAGE=s3
S3_BUCKET=bailamos-media
S3_ENDPOINT=https://REPLACE_WITH_S3_COMPATIBLE_ENDPOINT
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STORAGE_SECRET
MEDIA_SIGNING_SECRET=REPLACE_WITH_UNIQUE_RANDOM_48_BYTE_SECRET
CLIENT_ID_GOOGLE=115482478608-gsapgvhf2hs72mkcldn82u9pbk93m8i0.apps.googleusercontent.com
CLIENT_SECRET_GOOGLE=REPLACE_WITH_EXISTING_GOOGLE_SECRET
DEFAULT_CITY_SLUG=mexico-city
WORKER_CONCURRENCY=2
MEDIA_ORPHAN_DRY_RUN=true
# Optional: add only complete credential sets; otherwise buttons remain hidden.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ALERT_EMAIL=your-operations-mailbox@example.com
