# Resend Free; verify bailamos.me in Resend before using this sender.
# https://resend.com/pricing
# https://resend.com/docs/send-with-smtp
# Keep the API key only in local .env / Railway Variables.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
SMTP_FROM="Bailamos <noreply@bailamos.me>"
